{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.mapbox.MapboxMaps\/documentation\/Overview","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStore-APIs","doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode"]]},"sections":[],"abstract":[{"type":"text","text":"Tile store enabled for accessing local tile packs and for loading new tile packs from server."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"readAndUpdate"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"All tile requests are converted to tile pack requests, i.e.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the tile pack that includes the request tile will be loaded, and the tile extracted"},{"text":" ","type":"text"},{"type":"text","text":"from it. In this mode, no individual tile requests will be made."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This mode can be useful if the map trajectory is predefined and the user cannot pan"},{"type":"text","text":" "},{"text":"freely (e.g. navigation use cases), so that there is a good chance tile packs are already loaded","type":"text"},{"text":" ","type":"text"},{"text":"in the vicinity of the user.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If users can pan freely, this mode is not recommended. Otherwise, panning","type":"text"},{"type":"text","text":" "},{"type":"text","text":"will download tile packs instead of using individual tiles. Note that this means that we could first"},{"type":"text","text":" "},{"text":"download an individual tile, and then a tile pack that also includes this tile. The individual tile in","type":"text"},{"text":" ","type":"text"},{"text":"the disk cache won’t be used as long as the up-to-date tile pack exists in the cache.","type":"text"}]}],"kind":"content"}],"metadata":{"symbolKind":"case","modules":[{"name":"MapboxMaps"}],"navigatorTitle":[{"kind":"identifier","text":"MBMTileStoreUsageModeReadAndUpdate"}],"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"readAndUpdate","kind":"identifier"}],"roleHeading":"Case","role":"symbol","title":"TileStoreUsageMode.readAndUpdate","externalID":"c:@E@MBMTileStoreUsageMode@MBMTileStoreUsageModeReadAndUpdate"},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode\/readAndUpdate"},"references":{"doc://com.mapbox.MapboxMaps/documentation/MapboxMaps/TileStoreUsageMode/readAndUpdate":{"type":"topic","abstract":[{"type":"text","text":"Tile store enabled for accessing local tile packs and for loading new tile packs from server."}],"role":"symbol","title":"TileStoreUsageMode.readAndUpdate","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/TileStoreUsageMode\/readAndUpdate","kind":"symbol","url":"\/documentation\/mapboxmaps\/tilestoreusagemode\/readandupdate","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"readAndUpdate","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"MBMTileStoreUsageModeReadAndUpdate"}]},"doc://com.mapbox.MapboxMaps/documentation/Overview":{"url":"\/documentation\/overview","kind":"article","abstract":[],"title":"MapboxMaps Documentation","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/Overview","role":"collection","type":"topic"},"doc://com.mapbox.MapboxMaps/documenta