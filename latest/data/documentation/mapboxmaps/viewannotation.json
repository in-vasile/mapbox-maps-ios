":" ","kind":"text"},{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"ViewAnnotation","kind":"identifier"}]}]},{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use view annotations if you need to display interactive UIView bound to"},{"type":"text","text":" "},{"text":"a geographical coordinate or map feature.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The view annotations are great for displaying unique interactive features. However, they may be suboptimal for large amounts of data and don’t support clustering. For those cases use ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/PointAnnotation","isActive":true},{"type":"text","text":" or Runtime Styling API, for example, "},{"isActive":true,"identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/SymbolLayer","type":"reference"},{"type":"text","text":" with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/GeoJSONSource"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"View Annotations appear above all content of MapView (e.g. layers, annotations, puck). If you need to display annotation between layers or below puck, use "},{"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/PointAnnotation","isActive":true},{"text":".","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"type":"paragraph","inlineContent":[{"text":"To display a view annotation configure a UIView, create ","type":"text"},{"type":"codeVoice","code":"ViewAnnotation"},{"type":"text","text":", and add it to the view annotation manager:"}]},{"syntax":"swift","code":["let view = CustomView()","view.icon = UIImage(named: \"traffic-icon\")","let annotation = ViewAnnotation(","  coordinate: CLLocationCoordinate(latitude: 10, longitude: 10),","  view: view)","mapView.viewAnnotations.add(annotation)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The annotation can be displayed on a layer feature referenced by it’s "},{"type":"codeVoice","code":"layerId"},{"text":" and ","type":"text"},{"code":"featureId","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["annotation.annotatedFeature = .layerFeature(layerId: \"route-line\", featureId: \"sf-la\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The view annotation automatically inserts and removes it’s view into the view hierarchy and updates its "},{"type":"codeVoice","code":"isHidden"},{"text":" property.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t set "},{"type":"codeVoice","code":"UIView.isHidden"},{"type":"text","text":" property to hide the annotation. Instead, use "},{"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/ViewAnnotation\/visible","isActive":true},{"text":" property.","type":"text"}]}],"type":"aside","name":"Important"},{"inlineContent":[{"text":"When view content or layout is updated, use ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.mapbox.MapboxMaps\/documentation\/MapboxMaps\/ViewAnnotation\/setNeedsUpdateSize()","isActive":true},{"text":" to update the the annotation size. It’s safe to use it multiple times, only one update will be performed.","type":"text"}],"type":"paragraph"},{"code":["view.hintText = \"Less Traffic\"","annotation.setNeedsUpdateSize() \/\/ Updates the annotation size."],"syntax":"swift","type":"codeListing"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"ViewAnnotation","type":"codeVoice"},{"text":" uses ","type":"text"},{"type":"codeVoice","code":"UIView.syste